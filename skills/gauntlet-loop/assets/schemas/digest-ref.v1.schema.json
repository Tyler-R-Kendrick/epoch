{
  "$id": "https://schemas.gauntlet.dev/digest-ref.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Content identity. Never trust a filename as artifact identity.",
  "properties": {
    "algorithm": {
      "const": "sha256",
      "default": "sha256",
      "title": "Algorithm",
      "type": "string"
    },
    "byte_size": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Byte Size"
    },
    "media_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Media Type"
    },
    "schema_version": {
      "const": "dev.gauntlet.digest-ref/v1",
      "default": "dev.gauntlet.digest-ref/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "storage_uris": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Storage Uris",
      "type": "array"
    },
    "value": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Value",
      "type": "string"
    }
  },
  "required": [
    "value"
  ],
  "title": "DigestRefV1",
  "type": "object"
}
