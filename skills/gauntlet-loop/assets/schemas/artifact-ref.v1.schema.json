{
  "$defs": {
    "ArtifactRole": {
      "enum": [
        "normative",
        "canonical",
        "derived",
        "observational",
        "evaluative"
      ],
      "title": "ArtifactRole",
      "type": "string"
    },
    "DigestRefV1": {
      "additionalProperties": false,
      "description": "Content identity. Never trust a filename as artifact identity.",
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "byte_size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Size"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "schema_version": {
          "const": "dev.gauntlet.digest-ref/v1",
          "default": "dev.gauntlet.digest-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "storage_uris": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Storage Uris",
          "type": "array"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "DigestRefV1",
      "type": "object"
    }
  },
  "$id": "https://schemas.gauntlet.dev/artifact-ref.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._/-]+$",
      "title": "Artifact Id",
      "type": "string"
    },
    "digest": {
      "$ref": "#/$defs/DigestRefV1"
    },
    "logical_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Logical Name"
    },
    "representation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Representation"
    },
    "role": {
      "$ref": "#/$defs/ArtifactRole"
    },
    "schema_version": {
      "const": "dev.gauntlet.artifact-ref/v1",
      "default": "dev.gauntlet.artifact-ref/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "role",
    "digest"
  ],
  "title": "ArtifactRefV1",
  "type": "object"
}
