          "items": {
            "type": "string"
          },
          "title": "Evidence Floor",
          "type": "array"
        },
        "minimum_practical_effect": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Practical Effect"
        },
        "protected_regression_budgets": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Protected Regression Budgets",
          "type": "object"
        },
        "required_approvals": {
          "items": {
            "type": "string"
          },
          "title": "Required Approvals",
