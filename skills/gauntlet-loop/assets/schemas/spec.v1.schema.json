            {
              "type": "null"
            }
          ],
          "default": null
        },
        "concurrency_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concurrency Policy"
        },
        "frozen_surfaces": {
          "items": {
            "type": "string"
          },
          "title": "Frozen Surfaces",
