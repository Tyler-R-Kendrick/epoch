    },
    "SpecSplitsV1": {
      "additionalProperties": false,
      "properties": {
        "calibration_manifest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Manifest"
        },
        "promotion_manifest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promotion Manifest"
        },
        "search_manifest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search Manifest"
        }
      },
      "title": "SpecSplitsV1",
      "type": "object"
    },
    "StopPolicyV1": {
      "additionalProperties": false,
      "properties": {
        "disagreement_threshold": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disagreement Threshold"
        },
        "hard_budget": {
          "$ref": "#/$defs/BudgetV1"
        },
        "plateau_min_improvement": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plateau Min Improvement"
        },
        "plateau_window": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plateau Window"
        },
        "schema_version": {
          "const": "dev.gauntlet.stop-policy/v1",
          "default": "dev.gauntlet.stop-policy/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "target_condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Condition"
        },
        "unresolved_severity_threshold": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unresolved Severity Threshold"
        }
      },
      "required": [
        "hard_budget"
      ],
      "title": "StopPolicyV1",
      "type": "object"
    },
    "ToolRefV1": {
      "additionalProperties": false,
      "properties": {
        "contract_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract Digest"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "dev.gauntlet.tool-ref/v1",
          "default": "dev.gauntlet.tool-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolRefV1",
      "type": "object"
    },
    "TransformEdgeV1": {
      "additionalProperties": false,
      "properties": {
        "configuration_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Digest"
        },
        "cost_class": {
          "anyOf": [
            {
              "type": "string"
