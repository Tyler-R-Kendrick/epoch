            "$ref": "#/$defs/ArtifactNodeV1"
          },
          "title": "Nodes",
          "type": "array"
        },
        "required_consistency_relations": {
          "items": {
            "type": "string"
          },
          "title": "Required Consistency Relations",
          "type": "array"
        },
        "transforms": {
          "items": {
            "$ref": "#/$defs/TransformEdgeV1"
          },
          "title": "Transforms",
          "type": "array"
        }
      },
      "title": "SpecRepresentationsV1",
      "type": "object"
    },
    "SpecRuntimeV1": {
      "additionalProperties": false,
      "properties": {
        "allowed_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Capabilities",
          "type": "array"
        },
        "authority_ceiling": {
          "$ref": "#/$defs/ActionClass",
          "default": "R1"
        },
        "effect_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Policy"
        }
      },
      "title": "SpecRuntimeV1",
      "type": "object"
    },
    "SpecSearchSpaceV1": {
      "additionalProperties": false,
      "properties": {
