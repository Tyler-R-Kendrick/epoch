  "$id": "https://schemas.gauntlet.dev/spec.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evaluators": {
      "$ref": "#/$defs/SpecEvaluatorsV1"
    },
    "frozen": {
      "default": false,
      "title": "Frozen",
      "type": "boolean"
    },
    "frozen_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frozen Digest"
    },
    "goal": {
      "$ref": "#/$defs/SpecGoalV1"
    },
    "normative": {
      "$ref": "#/$defs/SpecNormativeV1"
    },
    "promotion": {
      "$ref": "#/$defs/SpecPromotionV1"
    },
