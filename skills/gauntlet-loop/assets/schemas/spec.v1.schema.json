        },
        "human_only_judgments": {
          "items": {
            "type": "string"
          },
          "title": "Human Only Judgments",
          "type": "array"
        },
        "protected_dimensions": {
          "items": {
            "type": "string"
          },
          "title": "Protected Dimensions",
          "type": "array"
        },
        "target_dimensions": {
          "items": {
            "type": "string"
          },
          "title": "Target Dimensions",
          "type": "array"
        }
      },
      "title": "SpecNormativeV1",
      "type": "object"
    },
    "SpecPromotionV1": {
      "additionalProperties": false,
