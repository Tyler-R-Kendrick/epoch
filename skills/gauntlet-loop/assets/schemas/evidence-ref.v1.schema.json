{
  "$id": "https://schemas.gauntlet.dev/evidence-ref.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Digest"
    },
    "kind": {
      "enum": [
        "observation",
        "belief",
        "counterexample",
        "evaluation",
        "trace",
        "artifact",
        "event"
      ],
      "title": "Kind",
      "type": "string"
    },
    "ref_id": {
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._/-]+$",
      "title": "Ref Id",
      "type": "string"
    },
    "schema_version": {
      "const": "dev.gauntlet.evidence-ref/v1",
      "default": "dev.gauntlet.evidence-ref/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "ref_id"
  ],
  "title": "EvidenceRefV1",
  "type": "object"
}
