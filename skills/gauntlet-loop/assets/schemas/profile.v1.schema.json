{
  "$defs": {
    "ArtifactNodeV1": {
      "additionalProperties": false,
      "properties": {
        "canonical_for": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical For"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "losses": {
          "items": {
            "type": "string"
          },
          "title": "Losses",
          "type": "array"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "node_id": {
          "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._/-]+$",
          "title": "Node Id",
          "type": "string"
        },
        "representation": {
          "minLength": 1,
          "title": "Representation",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ArtifactRole"
        },
        "schema_version": {
          "const": "dev.gauntlet.artifact-node/v1",
          "default": "dev.gauntlet.artifact-node/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "representation",
        "role"
      ],
      "title": "ArtifactNodeV1",
      "type": "object"
    },
    "ArtifactRole": {
      "enum": [
        "normative",
        "canonical",
        "derived",
        "observational",
        "evaluative"
      ],
      "title": "ArtifactRole",
      "type": "string"
    },
    "ToolRefV1": {
      "additionalProperties": false,
      "properties": {
        "contract_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract Digest"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "dev.gauntlet.tool-ref/v1",
          "default": "dev.gauntlet.tool-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolRefV1",
      "type": "object"
    },
    "TransformEdgeV1": {
      "additionalProperties": false,
      "properties": {
        "configuration_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Digest"
        },
        "cost_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Class"
        },
        "deterministic": {
          "title": "Deterministic",
          "type": "boolean"
        },
        "edge_id": {
          "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._/-]+$",
          "title": "Edge Id",
          "type": "string"
        },
        "expected_equivariances": {
          "items": {
            "type": "string"
          },
          "title": "Expected Equivariances",
          "type": "array"
        },
        "lossy": {
          "title": "Lossy",
          "type": "boolean"
        },
        "output_media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Media Type"
        },
        "protected_invariants": {
          "items": {
            "type": "string"
          },
          "title": "Protected Invariants",
          "type": "array"
        },
        "rights_implications": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rights Implications"
        },
        "round_trip_checks": {
          "items": {
            "type": "string"
          },
          "title": "Round Trip Checks",
          "type": "array"
        },
        "schema_version": {
          "const": "dev.gauntlet.transform-edge/v1",
          "default": "dev.gauntlet.transform-edge/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "tool": {
          "$ref": "#/$defs/ToolRefV1"
        }
      },
      "required": [
        "edge_id",
        "source",
        "target",
        "tool",
        "deterministic",
        "lossy"
      ],
      "title": "TransformEdgeV1",
      "type": "object"
    }
  },
  "$id": "https://schemas.gauntlet.dev/profile.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "default_protected_dimensions": {
      "items": {
        "type": "string"
      },
      "title": "Default Protected Dimensions",
      "type": "array"
    },
    "default_target_dimensions": {
      "items": {
        "type": "string"
      },
      "title": "Default Target Dimensions",
      "type": "array"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "display_name": {
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "evaluator_templates": {
      "items": {
        "type": "string"
      },
      "title": "Evaluator Templates",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/ArtifactNodeV1"
      },
      "title": "Nodes",
      "type": "array"
    },
    "profile_id": {
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._/-]+$",
      "title": "Profile Id",
      "type": "string"
    },
    "reference": {
      "minLength": 1,
      "title": "Reference",
      "type": "string"
    },
    "schema_version": {
      "const": "dev.gauntlet.profile/v1",
      "default": "dev.gauntlet.profile/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "transforms": {
      "items": {
        "$ref": "#/$defs/TransformEdgeV1"
      },
      "title": "Transforms",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "display_name",
    "description",
    "reference"
  ],
  "title": "RepresentationProfileV1",
  "type": "object"
}
