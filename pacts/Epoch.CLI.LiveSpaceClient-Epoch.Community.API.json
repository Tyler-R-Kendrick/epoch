{
  "consumer": {
    "name": "Epoch.CLI.LiveSpaceClient"
  },
  "interactions": [
    {
      "description": "a GET of one live session",
      "providerStates": [
        {
          "name": "live session livesession-pact is live"
        }
      ],
      "request": {
        "headers": {
          "X-Epoch-Principal": "principal-cli-host"
        },
        "method": "GET",
        "path": "/community/live/sessions/livesession-pact"
      },
      "response": {
        "body": {
          "receipt": {
            "data": {
              "lifecycle": "live",
              "sessionId": "livesession-pact"
            },
            "policy": {
              "decision": "allow"
            }
          },
          "schemaVersion": 1
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.receipt.data": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.receipt.policy": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.schemaVersion": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a GET of one live session before the media refusal",
      "providerStates": [
        {
          "name": "live session livesession-pact is live"
        }
      ],
      "request": {
        "headers": {
          "X-Epoch-Principal": "principal-cli-host"
        },
        "method": "GET",
        "path": "/community/live/sessions/livesession-pact"
      },
      "response": {
        "body": {
          "receipt": {
            "data": {
              "sessionId": "livesession-pact"
            }
          },
          "schemaVersion": 1
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.receipt.data": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.schemaVersion": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a POST of a live command the deployment refuses",
      "providerStates": [
        {
          "name": "live session livesession-pact refuses publication from this principal"
        }
      ],
      "request": {
        "body": {
          "confirmed": true,
          "input": {
            "actionId": "view.open",
            "args": {
              "view": "board"
            }
          },
          "kind": "live.presentation.publish"
        },
        "headers": {
          "Content-Type": "application/json",
          "X-Epoch-Principal": "principal-cli-host"
        },
        "method": "POST",
        "path": "/community/live/sessions/livesession-pact/commands"
      },
      "response": {
        "body": {
          "error": {
            "code": "policy-denied",
            "detail": "publishing is not permitted for this participant"
          },
          "schemaVersion": 1
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.error.detail": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.schemaVersion": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 403
      }
    },
    {
      "description": "a POST of one live command",
      "providerStates": [
        {
          "name": "live session livesession-pact is live"
        }
      ],
      "request": {
        "body": {
          "confirmed": true,
          "input": {},
          "kind": "live.presentation.status"
        },
        "headers": {
          "Content-Type": "application/json",
          "X-Epoch-Principal": "principal-cli-host"
        },
        "method": "POST",
        "path": "/community/live/sessions/livesession-pact/commands"
      },
      "response": {
        "body": {
          "receipt": {
            "data": {
              "quarantined": 0
            },
            "eventIds": [],
            "policy": {
              "decision": "allow"
            }
          },
          "schemaVersion": 1
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.receipt.data": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.receipt.eventIds": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 0
                }
              ]
            },
            "$.receipt.policy": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.schemaVersion": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.4.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "Epoch.Community.API"
  }
}