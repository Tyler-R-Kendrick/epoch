{
  "consumer": {
    "name": "Epoch.Community.Core"
  },
  "interactions": [
    {
      "description": "a request to list community repositories",
      "providerStates": [
        {
          "name": "community repositories exist"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/repositories"
      },
      "response": {
        "body": [
          {
            "changeProposals": [],
            "defaultView": "main",
            "description": "Event-driven DVCS",
            "discussions": [],
            "displayName": "Epoch",
            "issues": [],
            "maintainers": [
              "alice"
            ],
            "slug": "epoch/epoch",
            "topics": [
              "dvcs",
              "crdt"
            ],
            "visibility": "public"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to list community workflows",
      "providerStates": [
        {
          "name": "community workflows are available"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/workflows"
      },
      "response": {
        "body": [
          {
            "id": "repository-browsing",
            "label": "Repositories",
            "purpose": "Browse Epoch repositories"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to open a community issue",
      "providerStates": [
        {
          "name": "repository epoch/epoch exists"
        }
      ],
      "request": {
        "body": {
          "author": "bob",
          "labels": [
            "coverage"
          ],
          "title": "Browser feature coverage"
        },
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/repositories/epoch%2Fepoch/issues"
      },
      "response": {
        "body": {
          "changeProposals": [],
          "defaultView": "main",
          "description": "Event-driven DVCS",
          "discussions": [],
          "displayName": "Epoch",
          "issues": [
            {
              "author": "bob",
              "body": "",
              "comments": [],
              "id": "ISSUE-1",
              "labels": [
                "coverage"
              ],
              "status": "open",
              "title": "Browser feature coverage"
            }
          ],
          "maintainers": [
            "alice"
          ],
          "slug": "epoch/epoch",
          "topics": [
            "dvcs",
            "crdt"
          ],
          "visibility": "public"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 201
      }
    },
    {
      "description": "a request to propose a community change",
      "providerStates": [
        {
          "name": "repository epoch/epoch exists"
        }
      ],
      "request": {
        "body": {
          "author": "alice",
          "body": "wire provider verification",
          "sourceView": "feature/pact",
          "targetView": "main",
          "title": "Ship pact gates"
        },
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/repositories/epoch%2Fepoch/changes"
      },
      "response": {
        "body": {
          "changeProposals": [
            {
              "author": "alice",
              "body": "wire provider verification",
              "id": "CHANGE-1",
              "reviews": [],
              "sourceView": "feature/pact",
              "status": "open",
              "targetView": "main",
              "title": "Ship pact gates"
            }
          ],
          "defaultView": "main",
          "description": "Event-driven DVCS",
          "discussions": [],
          "displayName": "Epoch",
          "issues": [],
          "maintainers": [
            "alice"
          ],
          "slug": "epoch/epoch",
          "topics": [
            "dvcs",
            "crdt"
          ],
          "visibility": "public"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 201
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.4.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "Epoch.Community.API"
  }
}