{
  "consumer": {
    "name": "Epoch.Core.GossipClient"
  },
  "interactions": [
    {
      "description": "a POST snapshot exchange on /epoch/gossip",
      "providerStates": [
        {
          "name": "gossip peer repository is initialized"
        }
      ],
      "request": {
        "body": {
          "blobs": {},
          "events": [],
          "heads": [
            "head-a"
          ]
        },
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/epoch/gossip"
      },
      "response": {
        "body": {
          "blobs": {},
          "events": [],
          "heads": []
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.blobs": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.events": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.heads": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 0
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.5.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "Epoch.Core.GossipHttp"
  }
}