{
  "schemaVersion": 1,
  "kind": "project",
  "label": "Epoch Community Web",
  "product": {
    "id": "community-web",
    "package": "@epoch/community-web",
    "entry": "packages/Epoch.Community.Web"
  },
  "defaults": {
    "experiences": ["ux", "ax", "dx"],
    "driver": "web",
    "passes": "infinite",
    "delight": true,
    "survey": true,
    "reportOnly": false,
    "maxPersonas": 12
  },
  "personas": {
    "requireSchemaVersion": 2,
    "defaultPanel": "community-product",
    "panels": {
      "community-product": [
        "designer",
        "product-designer",
        "junior-mobile-designer",
        "screen-reader-power-user",
        "community-moderator",
        "app-builder-design-power-user",
        "discord-power-user",
        "slack-power-user",
        "github-power-user",
        "bluesky-power-user",
        "tangled-power-user",
        "buzz-power-user"
      ],
      "design-council": [
        "steve-jobs",
        "jony-ive",
        "naoto-fukasawa",
        "designer"
      ],
      "community-agents": [
        "buzz-power-user",
        "agentic-coding-power-user",
        "discord-power-user"
      ]
    }
  },
  "competitive": {
    "scorecard": ".optimizexp/competitive/community-web-dimensions.json",
    "scorecardDoc": "docs/community-web-experience-gap-scorecard.md",
    "requireScorecardOnComplete": true,
    "requireCurrencyForPolicies": ["research-before-respond"]
  },
  "features": {
    "defaultDriver": "web",
    "idPrefix": "community-web-"
  },
  "evidence": {
    "preferVideo": true,
    "overwritePrimary": true
  },
  "notes": [
    "Default panel is community-product: half design-craft lenses, half competitor bars, so bare optimizexp judges craft and competitive gaps together.",
    "design-council runs are triggered, not default: dimension status upgrades, milestone closeouts, and DESIGN.md edits require a runs/<id>/design-council.md verdict.",
    "Override with --personas or document panel choice in run scope.json.",
    "Update competitive scorecard dimensions after every mutating experiment.",
    "Panels live here only; .optimizexp/competitive/community-web-dimensions.json holds no panel block (sync-checked by test/unit/persona-map.test.ts)."
  ]
}
