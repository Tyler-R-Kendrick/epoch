  "$defs": {
    "canonicalId": {
      "type": "string",
      "pattern": "^epoch:(repo|principal|key|change|change-graph|fragment|review-bundle|merge-plan|conflict|workspace|operation|grant|budget|projection|mirror|version|session|promise|space|sandbox|anchor):[a-z2-7]{52}$"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
    },
    "fragmentSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "fragmentPrecondition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "absent"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "digest"
          ],
          "properties": {
            "kind": {
              "const": "digest"
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "fragmentProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principalId"
      ],
      "properties": {
        "principalId": {
          "type": "string",
          "pattern": "^epoch:principal:[a-z2-7]{52}$"
        },
        "sourceRevisionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
        }
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragmentId",
        "kind",
        "path",
        "precondition",
        "resultDigest",
        "order",
        "dependencies",
        "provenance",
        "mergeStrategy"
      ],
      "properties": {
        "fragmentId": {
          "type": "string",
          "pattern": "^epoch:fragment:[a-z2-7]{52}$"
        },
        "kind": {
          "enum": [
            "add",
            "delete",
            "move",
            "copy",
            "text",
            "structured",
            "binary"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"
        },
        "from": {
          "$ref": "#/$defs/fragmentSource"
        },
        "precondition": {
          "$ref": "#/$defs/fragmentPrecondition"
        },
        "resultDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contentRef": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64}|swh:[A-Za-z0-9:._~-]+|promise:epoch:promise:[a-z2-7]{52})$"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^epoch:fragment:[a-z2-7]{52}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "provenance": {
          "$ref": "#/$defs/fragmentProvenance"
        },
        "mergeStrategy": {
          "enum": [
            "exact",
            "text",
            "structured",
            "binary-replace"
          ]
        }
      }
    },
    "changeRevisionBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changeId",
        "baseFrontier",
        "baseTreeDigest",
        "parentRevisionIds",
        "fragments",
        "resultingTreeDigest",
        "authorPrincipalId"
      ],
      "properties": {
        "changeId": {
          "type": "string",
          "pattern": "^epoch:change:[a-z2-7]{52}$"
        },
        "baseFrontier": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "baseTreeDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parentRevisionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "fragments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fragment"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "resultingTreeDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorPrincipalId": {
          "type": "string",
          "pattern": "^epoch:principal:[a-z2-7]{52}$"
        }
      }
    },
    "changeGraphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
        },
        "kind": {
          "enum": [
            "requires",
            "orders-after",
            "conflicts-with",
            "derived-from"
          ]
        }
      }
    },
    "changeGraphBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changeGraphId",
        "memberRevisionIds",
        "edges"
      ],
      "properties": {
        "changeGraphId": {
          "type": "string",
          "pattern": "^epoch:change-graph:[a-z2-7]{52}$"
        },
        "memberRevisionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/changeGraphEdge"
          }
        }
      }
    },
    "splitGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragmentIds",
        "risk",
        "reason"
      ],
      "properties": {
        "fragmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^epoch:fragment:[a-z2-7]{52}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "ambiguous"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "splitBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRevisionId",
        "groups",
        "resultingRevisionIds",
        "reconstructionDigest"
      ],
      "properties": {
        "sourceRevisionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/splitGroup"
          },
          "minItems": 1
        },
        "resultingRevisionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reconstructionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "reviewOverlap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "right"
      ],
      "properties": {
        "left": {
          "type": "string",
          "pattern": "^epoch:fragment:[a-z2-7]{52}$"
        },
