        "space.workspace.bound",
        "space.turn.recorded",
        "space.budget.allocated",
        "space.capture.opened",
        "space.capture.closed",
        "space.capture.operation",
        "space.anchor.recorded"
      ]
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
    },
    "body": {
      "type": "object"
    }
  },
