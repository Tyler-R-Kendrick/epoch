        "structuralPath",
        "contentDigest"
      ],
      "properties": {
        "spaceId": {
          "type": "string",
          "pattern": "^epoch:space:[a-z2-7]{52}$"
        },
        "anchorId": {
          "type": "string",
          "pattern": "^epoch:anchor:[a-z2-7]{52}$"
