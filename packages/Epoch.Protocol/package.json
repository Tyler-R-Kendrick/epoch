{
  "name": "@epoch/protocol",
  "version": "0.1.0",
  "description": "Browser-safe canonical identifiers, events, schemas, and capability contracts for Epoch convergence.",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsgo -p tsconfig.json",
