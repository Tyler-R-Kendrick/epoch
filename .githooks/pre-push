#!/usr/bin/env sh
set -eu

# Local pre-push mirrors pre-commit (`gate:commit`). Prefer `npm run gate:push`
# before a PR when typecheck/build/unit are green; full verify stays CI.
#
# Bypass (emergency only): SKIP_GIT_HOOKS=1 git push ...
if [ -n "${SKIP_GIT_HOOKS:-}" ] || [ -n "${CI:-}" ]; then
  exit 0
fi

echo "pre-push: running gate:commit (CI remains authoritative for verify)"
unset $(git rev-parse --local-env-vars)
npm run gate:commit
