#!/usr/bin/env sh
set -eu

# Fast local pre-commit gate (Monorepo DX Playbook + Epoch agent workflow).
# Full suite runs on pre-push via `npm run gate:push` / `npm run verify`.
#
# Bypass (emergency only): SKIP_GIT_HOOKS=1 git commit ...
if [ -n "${SKIP_GIT_HOOKS:-}" ] || [ -n "${CI:-}" ]; then
  exit 0
fi

# Whitespace and merge-conflict-marker hygiene on staged content.
git diff --cached --check

# Fast structural + docs + design + lint gates.
npm run gate:fast
