#!/usr/bin/env sh
set -eu

# Strengthened local pre-commit gate (`npm run gate:commit`):
#   - parallel static checks (konsistent, docs, design, ESLint, anti-slop Oxlint)
#   - Community Web a11y lint (same check as the CI Lint job)
# Typecheck, build, unit, coverage, Pact, and e2e remain in `gate:push` /
# `verify` and GitHub Actions until the anti-slop typecheck debt is cleared.
#
# Bypass (emergency only): SKIP_GIT_HOOKS=1 git commit ...
if [ -n "${SKIP_GIT_HOOKS:-}" ] || [ -n "${CI:-}" ]; then
  exit 0
fi

git diff --cached --check

echo "pre-commit: running gate:commit (parallel static + a11y lint)"
npm run gate:commit
