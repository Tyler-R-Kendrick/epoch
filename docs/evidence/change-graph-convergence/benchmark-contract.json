{
  "schemaVersion": 1,
  "suite": "change-graph-convergence",
  "entrypoint": "benchmarks/change-graph-convergence.mjs",
  "optInEnvironment": "EPOCH_RUN_CHANGE_GRAPH_BENCHMARKS=1",
  "baselineEnvironment": "EPOCH_CHANGE_GRAPH_BASELINE",
  "fixture": {
    "objects": 2000,
    "workspaceFiles": 250,
    "fragments": 200,
    "changeGraphRevisions": 500,
    "mirrorOperations": 1000,
    "budgetReservations": 500,
    "blobBytes": 2000000
