{
  "name": "epoch",
  "version": "0.1.0",
  "description": "Minimal event-driven DVCS prototype with pluggable CRDT entity-level merging.",
  "main": "dist/src/index.js",
  "bin": {
    "epoch": "dist/src/cli.js",
    "epoch-git": "dist/src/cli-git.js"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./Epoch.Core.Git": "./dist/src/git.js",
    "./Epoch.CLI.Git": "./dist/src/cli-git.js",
    "./Epoch.WASM.Git": "./dist/src/wasm-git.js"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "features": "npm run build -- --pretty false && cucumber-js features/**/*.feature --require dist/test/features/**/*.js",
    "test": "npm run features"
  },
  "keywords": [
    "dvcs",
    "crdt",
    "typescript",
    "tsgo"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.2",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "^7.0.0-dev.20260504.1"
  },
  "dependencies": {
    "@collabs/collabs": "0.13.4",
    "protobufjs": "7.5.5",
    "xstate": "^5.31.0"
  },
  "overrides": {
    "protobufjs": "7.5.5"
  }
}
