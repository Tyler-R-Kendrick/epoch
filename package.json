{
  "name": "epoch",
  "version": "0.1.0",
  "description": "Epoch workspace for core SDK, CLI, and WASM hosts.",
  "private": true,
  "workspaces": [
    "packages/Epoch.Core",
    "packages/Epoch.CLI",
    "packages/Epoch.WASM"
  ],
  "main": "dist/packages/Epoch.Core/src/index.js",
  "bin": {
    "epoch": "dist/packages/Epoch.CLI/src/cli.js"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "features": "npm run build -- --pretty false && cucumber-js features/**/*.feature --require dist/test/features/**/*.js",
    "test": "npm run features"
  },
  "keywords": [
    "dvcs",
    "crdt",
    "typescript",
    "tsgo"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.2",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "^7.0.0-dev.20260504.1"
  },
  "dependencies": {
    "xstate": "^5.31.0",
    "zod": "^4.4.3"
  }
}
