{
  "name": "epoch",
  "version": "0.1.0",
  "description": "Epoch workspace for core SDK, CLI, and WASM hosts.",
  "private": true,
  "workspaces": [
    "packages/Epoch.Core",
    "packages/Epoch.CLI",
    "packages/Epoch.WASM"
  ],
  "main": "packages/Epoch.Core/dist/index.js",
  "bin": {
    "epoch": "packages/Epoch.CLI/dist/cli.js",
    "epoch-git": "packages/Epoch.CLI/dist/cli-git.js"
  },
  "exports": {
    ".": "./packages/Epoch.Core/dist/index.js",
    "./Epoch.Core.Git": "./packages/Epoch.Core/dist/git.js",
    "./Epoch.CLI.Git": "./packages/Epoch.CLI/dist/cli-git.js",
    "./Epoch.WASM.Git": "./packages/Epoch.WASM/dist/git.js"
  },
  "scripts": {
    "build": "npm run build -w @epoch/core && npm run build -w @epoch/cli && npm run build -w @epoch/wasm && tsgo -p tsconfig.test.json",
    "features": "npm run build -- --pretty false && cucumber-js features/**/*.feature --require dist/test/features/**/*.js",
    "test": "npm run features"
  },
  "keywords": [
    "dvcs",
    "crdt",
    "typescript",
    "tsgo"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.2",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "^7.0.0-dev.20260504.1"
  },
  "dependencies": {
    "@collabs/collabs": "0.13.4",
    "protobufjs": "7.5.5",
    "xstate": "^5.31.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "protobufjs": "7.5.5"
  }
}
